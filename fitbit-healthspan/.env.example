# Google Cloud OAuth client (type: Web application) with the Google Health API enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/callback
PORT=8787
# HOST=0.0.0.0   # uncomment to reach the app from your phone on the same network (then use your LAN IP in the redirect URI)
